# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Resend API key (server-only). https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered (defaults to the email in src/content/site.ts).
# Without a verified Resend domain this must be the email address of your Resend account.
CONTACT_TO_EMAIL=

# Sender address. Defaults to "Portfolio Contact <onboarding@resend.dev>".
# After verifying a domain in Resend, use e.g. "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Public canonical URL used for metadata, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://mrityunjay-kumar.vercel.app
